# MySQL
# Keep DB_PASSWORD equal to DATABASE_ROOT_PASSWORD while services use the root user.
DATABASE_ROOT_PASSWORD=change_me
DATABASE_NAME=qlphim
DB_PASSWORD=change_me
DB_HOST=db
DB_PORT=3306
DB_PORT_HOST=3306

# Published ports
IDENTITY_SERVICE_PORT=8080
MOVIE_SERVICE_PORT=8081
TICKET_SERVICE_PORT=8082
AI_SERVICE_PORT=8083
API_GATEWAY_PORT=8888
FRONTEND_PORT=5173

# Docker service discovery
IDENTITY_SERVICE_HOST=identity-service
MOVIE_SERVICE_HOST=movie-service
TICKET_SERVICE_HOST=ticket-service
AI_SERVICE_HOST=ai-service

# OpenRouter / AI
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_MODEL=dots-studio/dots-3-note-preview:free
OPENROUTER_FALLBACK_MODEL=nvidia/nemotron-nano-9b-v2:free

# TMDB
TMDB_API_KEY=your_tmdb_api_key

# PayPal Sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_FRONTEND_URL=http://localhost:5173/payment-result
PAYPAL_VND_TO_USD_RATE=25000

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

TZ=Asia/Ho_Chi_Minh
